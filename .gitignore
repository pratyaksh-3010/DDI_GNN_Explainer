# ============================================
# .gitignore for Polypharmacy GNN Project
# ============================================

# ----- Python Bytecode & Virtual Environments -----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg
.Python
env/
venv/
.venv/
*.virtualenv

# ----- IDE / OS Files -----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ----- Datasets & Data Files (Large CSV / TSV / SQL) -----
*.csv
*.tsv
*.sql
*.dump

# Raw Dataset Folders & Archives
bio-decagon-*/
bio-decagon-*.tar.gz
RxNorm_full_prescribe_*/
drugcentral.dump.*/
faers_ascii_*/
meddra_all_se.tsv/
STREAMLIT_FRONTEND/DATA/

# Graph Data & Processed Datasets
**/Graph_Data/
**/Processed/
RESULTS/

# ----- Model Weights & Binary Checkpoints -----
*.pth
*.pt
*.pkl
*.pickle
*.bin
*.onnx
*.h5
*.pb

# ----- Archives & Compressed Files -----
*.zip
*.tar.gz
*.tgz
*.tar
*.gz
*.rar
*.7z

# ----- Documents, Slides & Presentation Files -----
*.docx
*.pdf
*.pptx
*.xlsx
